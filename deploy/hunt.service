[Unit]
Description=Hunt memecoin paper-trading bot
After=network-online.target
Wants=network-online.target

[Service]
User=hunt
WorkingDirectory=/home/hunt/hunt
ExecStart=/home/hunt/hunt/.venv/bin/python -m hunt.paper.run 604800
Restart=always
RestartSec=10
# campaign clock: the run itself computes remaining time from state/run_meta.json
# on restarts handled by the bot; systemd covers crashes within 10s.
Environment=PYTHONUNBUFFERED=1

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/hunt/hunt

[Install]
WantedBy=multi-user.target
