# ============ REQUIRED KEYS (all free) ============
# Helius - https://dashboard.helius.dev -> API Keys -> New Key
HUNT_HELIUS_API_KEY=

# Birdeye - https://bds.birdeye.so -> sign up free -> create API key
HUNT_BIRDEYE_API_KEY=

# GMGN (optional but recommended) - https://gmgn.ai/ai -> create API key
# Falls back to the public demo key (read-only) when empty.
HUNT_GMGN_API_KEY=

# Telegram - @BotFather -> /newbot -> copy token.
# Then message your bot once, open https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy your chat id from the response.
HUNT_TELEGRAM_BOT_TOKEN=
HUNT_TELEGRAM_CHAT_ID=

# ============ LIVE TRADING (leave empty until ready) ============
# Dedicated bot wallet ONLY. Generate with: python -m hunt.utils.solana gen-wallet
# Fund it with a small amount of SOL before enabling live mode.
HUNT_WALLET_PRIVATE_KEY=

# true = paper trading (no funds at risk). Set false ONLY when going live.
HUNT_DRY_RUN=true

# ============ TUNING (defaults are sane) ============
HUNT_TRADE_SIZE_SOL=0.05
HUNT_MAX_TRACKED_WALLETS=8
HUNT_MAX_OPEN_POSITIONS=8
HUNT_SLIPPAGE_BPS=2000
HUNT_PRIORITY_FEE_MAX_LAMPORTS=1000000
